# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API Keys). El proyecto del equipo es:
#   VITE_SUPABASE_URL=https://eprsowelxtpvtbsvnalk.supabase.co
#
# Si dejas estas dos líneas vacías, la app funciona en MODO DEMO:
# datos de ejemplo guardados solo en el navegador, sin servidor.
#
# Usa SOLO la clave pública: "publishable" (sb_publishable_…) o la antigua "anon".
# Las claves secretas (sb_secret_… o "service_role") NUNCA van aquí,
# ni en el repositorio, ni en GitHub: da acceso total a la base de datos.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
