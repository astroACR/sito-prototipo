# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API).
#
# Si dejas estas dos líneas vacías, la app funciona en MODO DEMO:
# datos de ejemplo guardados solo en el navegador, sin servidor.
#
# Usa SOLO la clave pública "anon". La clave "service_role" NUNCA va aquí,
# ni en el repositorio, ni en GitHub: da acceso total a la base de datos.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
