{
  "name": "sito",
  "private": true,
  "version": "1.0.0",
  "description": "SITO · Sistema Integral de Trazabilidad de Obras (PWA para trabajadores y supervisores de obra)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/generar-sql.mjs",
    "probar:supabase": "node scripts/probar-supabase.mjs",
    "db:enlazar": "supabase link",
    "db:subir": "supabase db push --remote --include-seed",
    "db:reiniciar-demo": "supabase db query --remote --file supabase/reset-demo.sql",
    "db:revisar": "supabase db advisors --remote --type all --level warn",
    "db:borrar-fotos": "supabase storage rm -r ss:///evidencias/obras --remote --experimental"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "playwright-core": "^1.65.1",
    "supabase": "^3.2.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
